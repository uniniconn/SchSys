// Prisma schema —— 排班系统
//
// 数据库切换说明（Prisma 不允许 provider 使用 env()，因此 provider 是硬编码的）：
//   本地默认： provider = "sqlite"      + DATABASE_URL="file:./data/app.db"
//   云服务器： provider = "postgresql"  + DATABASE_URL="postgresql://..."
// 使用 npm run db:switch:postgres / npm run db:switch:sqlite 一键切换，
// 两个 provider 的迁移目录互相独立：prisma/migrations (sqlite) 与 prisma/migrations-postgresql。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 管理员账号
model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  displayName  String?
  /// active | disabled
  status       String   @default("active")
  isSuper      Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("admins")
}

/// 排班任务
model Task {
  id          String @id @default(uuid())
  name        String
  description String?
  dateStart   String // yyyy-MM-dd
  dateEnd     String // yyyy-MM-dd
  /// 填写截止时间
  fillDeadline DateTime?

  /// 填写密码哈希（可重置）
  fillPasswordHash String
  /// 填写链接 UUID，不可枚举
  publicToken      String   @unique @default(uuid())
  /// draft | published | confirmed(已截止确认) | matched(已匹配)
  status           String   @default("draft")
  /// 允许同一用户同日多班（仅当班次时间完全不重叠时生效）
  allowSameDayMultiple Boolean @default(false)
  /// 区域分人模式：shared=同一时段一人可兼顾同组多个区域；exclusive=区域独立分人
  areaCoverage     String @default("shared")
  /// shared 模式下每人每时段最多兼顾的区域数
  maxAreasPerPerson Int   @default(2)
  /// 日历快照（JSON：条目、来源、抓取时间、自定义），保证历史任务可复现
  calendarConfig   String?
  /// 少排偏好的默认上限（可空）
  lessDefaultMax   Int?
  /// 匹配随机种子
  matchSeed        Int?
  /// 最近一次匹配是否全部满足
  matchFeasible    Boolean?
  matchSummary     String?
  lastMatchedAt    DateTime?
  confirmedAt      DateTime?
  confirmedBy      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  shifts       Shift[]
  areas        Area[]
  requirements TaskDayRequirement[]
  roster       RosterEntry[]
  submissions  Submission[]
  selections   Selection[]
  assignments  Assignment[]
  auditLogs    AuditLog[]

  @@map("tasks")
}

/// 班次定义（属于某个任务）
model Shift {
  id         String  @id @default(uuid())
  taskId     String
  name       String
  startTime  String // HH:mm
  endTime    String // HH:mm
  /// 默认所需人数
  defaultHeadcount Int  @default(1)
  sortOrder  Int     @default(0)
  colorKey   String? // 展示用（纯色，不使用渐变/透明度）
  /// 日期规则（JSON：weekdays / eveOfWorkday / excludeHolidays / includeDates / excludeDates）
  dateRule   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task         Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  areas        Area[]
  requirements TaskDayRequirement[]
  selections   Selection[]
  assignments  Assignment[]

  @@unique([taskId, name])
  @@index([taskId])
  @@map("shifts")
}

/// 区域（属于某个班次/时段；同一时段可多个区域，可归属不同距离组）
model Area {
  id               String  @id @default(uuid())
  taskId           String
  shiftId          String
  name             String
  /// 距离组：同一组内一个人可兼顾多个区域；跨组不允许同时段兼顾
  groupName        String  @default("默认组")
  defaultHeadcount Int     @default(1)
  sortOrder        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task         Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  shift        Shift                 @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  requirements TaskDayRequirement[]
  assignments  Assignment[]

  @@unique([shiftId, name])
  @@index([taskId])
  @@index([taskId, groupName])
  @@map("areas")
}

/// 按天、按班次、按区域的需求人数
model TaskDayRequirement {
  id        String @id @default(uuid())
  taskId    String
  shiftId   String
  areaId    String
  /// yyyy-MM-dd
  date      String
  headcount Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  area  Area  @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([taskId, shiftId, areaId, date])
  @@index([taskId, date])
  @@index([taskId, areaId])
  @@map("task_day_requirements")
}

/// 上传的名单（用于核对已填/未填）
model RosterEntry {
  id      String  @id @default(uuid())
  taskId  String
  name    String
  empNo   String?
  dept    String?
  /// 归一化后的姓名，用于匹配
  nameKey String

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, nameKey])
  @@map("roster_entries")
}

/// 用户提交
model Submission {
  id           String @id @default(uuid())
  taskId       String
  /// 姓名（展示用，保留用户输入）
  name         String
  /// 归一化姓名，同一任务内唯一，用于“同名再进入修改”
  nameKey      String
  empNo        String?
  dept         String?
  /// 是否来自名单
  onRoster     Boolean @default(false)
  /// submitted | locked
  status       String  @default("submitted")
  /// 工作量偏好：more（希望多排） | normal | less（希望少排）
  workloadPreference String @default("normal")
  /// 最多可排班次数（空表示不限制）
  maxAssignments     Int?
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@unique([taskId, nameKey])
  @@index([taskId])
  @@map("submissions")
}

/// 用户对“日期+班次”的意愿：preferred(首选) | backup(次选) | unavailable(无法)
model Selection {
  id           String @id @default(uuid())
  submissionId String
  taskId       String
  shiftId      String
  date         String // yyyy-MM-dd
  /// preferred | backup | unavailable
  choice       String
  reason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  shift      Shift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([submissionId, shiftId, date])
  @@index([taskId, date])
  @@map("selections")
}

/// 最终排班结果
model Assignment {
  id           String @id @default(uuid())
  taskId       String
  shiftId      String
  areaId       String
  date         String // yyyy-MM-dd
  submissionId String
  name         String
  /// preferred | backup | manual（管理员手动指定且该人员未选择首选/次选）
  source       String
  /// 匹配批次，便于重新匹配时整体替换；手动调整的记录为 "manual"
  batchId      String
  seed         Int
  /// 历史排班次数（用于公平规则复现）
  historyCount Int    @default(0)
  /// 是否由管理员手动加入/调整（自动匹配为 false）
  manual       Boolean @default(false)
  /// 手动调整说明（调整人、原因等）
  note         String?

  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  area  Area  @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([taskId, date, shiftId, areaId, submissionId])
  @@index([taskId, date])
  @@index([taskId, batchId])
  @@index([taskId, areaId])
  @@map("assignments")
}

/// 日历缓存（按年份保存从公共 API 获取并规范化后的节假日/调休）
model CalendarCache {
  year      Int      @id
  provider  String
  dataJson  String
  papers    String?
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("calendar_cache")
}

/// 自定义日历覆盖（优先级高于 API/缓存）
model CalendarOverride {
  id        String   @id @default(uuid())
  year      Int
  date      String // yyyy-MM-dd
  /// holiday | workday（workday 表示调休补班）
  kind      String
  name      String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, date])
  @@index([year])
  @@map("calendar_overrides")
}

/// 管理员操作日志
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String?
  taskId    String?
  action    String
  detail    String?
  ipAddress String?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("audit_logs")
}
